
{
  "version": 2,
  "builds": [
    {
      "src": "app/package.json",
      "use": "@vercel/next",
      "config": {
        "distDir": "app/.next"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/app/$1"
    }
  ],
  "functions": {
    "app/pages/api/**/*.js": {
      "maxDuration": 30
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}
